# ============================================================================
# FADÉ EXCLUSIVE — ENVIRONMENT VARIABLES (.env.example)
# Copy to .env.local for development. Never commit real secrets.
# ============================================================================

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-west-2.aws.neon.tech/fade_exclusive?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.eu-west-2.aws.neon.tech/fade_exclusive?sslmode=require"

# Authentication (Better Auth)
BETTER_AUTH_SECRET="replace-with-at-least-32-char-high-entropy-secret-key"
BETTER_AUTH_URL="http://localhost:3000"

# Hidden Admin Route Slug (Server-only! Never expose via NEXT_PUBLIC_*)
# Access admin at: http://localhost:3000/<ADMIN_PATH_SLUG>/dashboard
ADMIN_PATH_SLUG="fade-atelier-ops-9x7k"

# Public Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_PUBLIC_BUCKET="fade-public-media"
R2_PRIVATE_BUCKET="fade-private-uploads"
R2_PUBLIC_BASE_URL="https://media.fadeexclusive.com"

# Transactional Email (Resend)
RESEND_API_KEY="re_placeholder_key"
EMAIL_FROM="Fadé Exclusive <atelier@fadeexclusive.com>"

# Cloudflare Turnstile Bot Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Upstash Redis Rate Limiting (optional; falls back to in-memory/DB limiter)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Scheduled Cron Job Protection Secret (/api/cron/expire-orders)
CRON_SECRET="replace-with-random-cron-secret"

# Optional Error Monitoring
SENTRY_DSN=""

# Initial Owner Account (development/testing — in-memory store)
# Provisioned automatically when the server starts (src/instrumentation.ts).
# Restart the dev server after changing these. Password: 12+ characters.
OWNER_EMAIL="owner@fadeexclusive.com"
OWNER_PASSWORD="replace-with-a-strong-owner-password"
OWNER_NAME="Fadé Owner"
